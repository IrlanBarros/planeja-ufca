  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "analyze:build": "node scripts/analyze-build.mjs",
